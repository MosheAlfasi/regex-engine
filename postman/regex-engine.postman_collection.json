              "mode": "raw",
              "raw": "{\n  \"source\": {\n    \"type\": \"HTTP\",\n    \"url\": \"https://httpbin.org/headers\",\n    \"headers\": {\n      \"Authorization\": \"Bearer <TOKEN>\",\n      \"X-Custom-Test\": \"hello-noma\"\n    }\n  },\n  \"contentType\": \"RAW\",\n  \"patterns\": [\n    \"\\\"Authorization\\\": \\\"[^\\\"]+\\\"\",\n    \"\\\"X-Custom-Test\\\": \\\"[^\\\"]+\\\"\"\n  ]\n}",
