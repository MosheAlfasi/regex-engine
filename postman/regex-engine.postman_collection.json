{
  "info": {
    "name": "Regex Engine",
    "description": "Noma home assignment - regex scan engine. Run the app (./mvnw spring-boot:run) and create the fixtures in ~/scan-files for the FILE requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8087/anomaly-detector"
    }
  ],
  "item": [
    {
      "name": "1 - Websites",
      "item": [
        {
          "name": "Hacker News - all hyperlinks",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": {\n    \"type\": \"HTTP\",\n    \"url\": \"https://news.ycombinator.com\"\n  },\n  \"contentType\": \"RAW\",\n  \"patterns\": [\n    \"<a\\\\s+[^>]*href=\\\"[^\\\"]+\\\"\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/scan",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "scan"
              ]
            },
            "description": ""
          }
        },
